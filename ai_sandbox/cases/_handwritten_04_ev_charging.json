    {"name": "Receive session record", "server": "OCPP backend", "data_transferred_kb": 5, "request_duration_s": 0.1},
    {"name": "Write session record", "server": "Postgres database", "data_stored_kb": 5},
    {"name": "Load dashboard", "server": "OCPP backend", "data_transferred_kb": 1500},
    {"name": "Query station status", "server": "Postgres database", "data_transferred_kb": 50}
  ],
  "journeys": [
    {"name": "Operator watches stations", "steps": [
      {"name": "Open dashboard", "user_time_spent_min": 1, "jobs": ["Load dashboard"]},
      {"name": "Follow station status", "user_time_spent_min": 30, "jobs": ["Query station status"]}]}
  ],
  "usage_patterns": [
