       {"jobs": ["Receive session record", "Write session record"], "times_per_hour": 0.33, "comment": "8 sessions a day, each written to Postgres"}]}
  ],
  "edge_journeys": [
    {"name": "Station operation", "functions": ["Report status and sessions"]}
